                  url = (BASE + "/v1beta/models/" + model
                         + ":generateContent?key=" + os.environ["GEMINI_API_KEY"])
                  body = json.dumps({"contents":[{"role":"user","parts":[{"text":PROMPT}]}],
                                     "generationConfig":{"temperature":0.2,"maxOutputTokens":16384}}).encode()
              def _body_for(m):
                  if PROVIDER == "openai-compat":
                      return json.dumps({"model": m,
                                         "messages":[{"role":"user","content":PROMPT}],
                                         "temperature":0.2, "max_tokens":16384,
                                         "reasoning": {"enabled": False,
                                                       "max_tokens": 4096}}).encode()
                  return json.dumps({"contents":[{"role":"user","parts":[{"text":PROMPT}]}],
                                     "generationConfig":{"temperature":0.2,
                                                         "maxOutputTokens":16384}}).encode()
              answer = ""
              attempt = 0
              while not answer:
                  req = urllib.request.Request(url, data=body, headers=headers)
                  try:
                      r = urllib.request.urlopen(req, timeout=180)
                      d = json.loads(r.read())
                      if PROVIDER == "openai-compat":
                          answer = ((d.get("choices") or [{}])[0].get("message",{})
                                    .get("content") or "").strip()
                      else:
                          cands = d.get("candidates") or []
                          if not cands:
                              raise RuntimeError("no candidates: " + json.dumps(d)[:300])
                          answer = "".join(p.get("text","") for p in cands[0].get("content",{}).get("parts",[])).strip()
                      if answer:
                          break
                      raise RuntimeError("empty content")
                  except urllib.error.HTTPError as e:
                      msg = e.read().decode()[:300]
                      print("HTTP", e.code, msg[:200], flush=True)
                      raw_tail = (raw_tail + "\nHTTP " + str(e.code) + ": " + msg).strip()[-4000:]
                      if e.code == 429 and len(model_q) > 1:
                          # W22: quota wyczerpana na modelu glownym -> fallback
                          model_q.pop(0)
                          model = model_q[0]
                          print("FAILOVER ->", model, flush=True)
                          if PROVIDER == "gemini":
                              url = (BASE + "/v1beta/models/" + model
                                     + ":generateContent?key="
                                     + os.environ["GEMINI_API_KEY"])
                          body = _body_for(model)
                          attempt = 0
                          continue
                      if e.code in (429, 500, 503) and attempt < 5:
                          attempt += 1
                          time.sleep(25 * attempt)
                          continue
                      raise
              print("MODEL_IN_USE:", model, flush=True)
              if not answer:
                  raise RuntimeError("empty answer from LLM (" + PROVIDER + ")")
              print("ANSWER_LEN:", len(answer), flush=True)
              raw_tail = answer[-1500:]

              # 4) ekstrakcja blokow -> pliki
              # multi-file: gdy pierwszy blok ma naglowek "# FILE: <path>", kazdy blok
              # zapisujemy do wskazanego pliku (wyłącznie src/); inaczej tryb single-file
              blocks = re.findall(r"```(?:python)?\s*\n(.*?)```", answer, re.S)
              if len(blocks) < 1:
                  raise RuntimeError(f"expected 1 code block, got {len(blocks)}; head=" + answer[:400])
              if re.search(r"^#\s*FILE:\s*\S+", blocks[0], re.M):
                  writes = []
                  for b in blocks:
                      fm = re.search(r"^#\s*FILE:\s*(\S+)", b, re.M)
                      if not fm:
                          raise RuntimeError("multi-file blok bez naglowka # FILE: " + b[:120])
                      rel = fm.group(1)
                      if not rel.startswith("src/"):
                          raise RuntimeError("sciezka poza src/: " + rel)
                      code = b[fm.end():].strip() + "\n"
                      writes.append((rel, code))
                  d1 = []
                  for rel, code in writes:
                      full = os.path.join(repo, rel)
                      old_f = open(full, encoding="utf-8").read() if os.path.exists(full) else ""
                      os.makedirs(os.path.dirname(full), exist_ok=True)
                      open(full, "w", encoding="utf-8").write(code)
                      d1 += list(difflib.unified_diff(old_f.splitlines(True), code.splitlines(True),
                              "a/" + rel, "b/" + rel))
              else:
                  src_code = blocks[0].strip() + "\n"
                  src_path = os.path.join(repo, "src", "lab", "__init__.py")
                  old_src = open(src_path, encoding="utf-8").read() if os.path.exists(src_path) else ""
                  os.makedirs(os.path.dirname(src_path), exist_ok=True)
                  open(src_path, "w", encoding="utf-8").write(src_code)
                  d1 = None  # single-file: diff liczony w kroku 7

              # 5) deterministyczne testy wlasne (zgodne ze spec), pisane przez skrypt
              test_code = "\n".join([
                  'import sys',
                  "sys.path.insert(0, 'src')",
                  'from lab import parse_commit',
                  '',
                  "assert parse_commit('feat: add login') == {'type': 'feat', 'scope': None, 'breaking': False, 'description': 'add login'}, 'simple'",
                  "assert parse_commit('fix(auth): correct token refresh') == {'type': 'fix', 'scope': 'auth', 'breaking': False, 'description': 'correct token refresh'}, 'scope'",
                  "assert parse_commit('feat(api)!: remove v1 endpoints')['breaking'] is True, 'breaking'",
                  "assert parse_commit('chore:  double space kept')['description'] == ' double space kept', 'one space stripped'",
                  "assert parse_commit('docs: read routes|paths')['description'] == 'read routes|paths', 'pipe kept'",
                  "assert parse_commit('feat: x\\n\\nBody with: colon')['description'] == 'x', 'body ignored'",
                  "assert parse_commit('refactor(core): a|b|c') == {'type': 'refactor', 'scope': 'core', 'breaking': False, 'description': 'a|b|c'}, 'pipes in desc'",
                  'try:',
                  "    parse_commit('feat add login'); raise SystemExit('no ValueError')",
                  'except ValueError:',
                  '    pass',
                  'try:',
                  "    parse_commit('FEAT: x'); raise SystemExit('no ValueError uppercase')",
                  'except ValueError:',
                  '    pass',
                  'try:',
                  "    parse_commit('feat(): x'); raise SystemExit('no ValueError empty scope')",
                  'except ValueError:',
                  '    pass',
                  "print('ALL SPEC TESTS PASSED')",
                  ""])
              test_path = os.path.join(repo, "tests", "test_conventional_commit.py")
              os.makedirs(os.path.dirname(test_path), exist_ok=True)
              open(test_path, "w", encoding="utf-8").write(test_code)

              # 6) testy w sandboxie
              t = sh(f"cd {repo} && for t in tests/test_*.py; do echo \"==TESTFILE $t==\"; python3 $t || exit 1; done", timeout=120)
              tests_out = (((t.stdout or "") + "\n" + (t.stderr or ""))[-2000:]) if t else "TIMEOUT"
              print("TESTS_RC:", t.returncode if t else "timeout", flush=True)
              if not t or t.returncode != 0:
                  raise RuntimeError("tests failed in sandbox")

              # 7) unified diff (bez git w sandboxie); multi-file policzony w kroku 4
              if d1 is None:
                  d1 = list(difflib.unified_diff(old_src.splitlines(True), src_code.splitlines(True),
                        "a/src/lab/__init__.py", "b/src/lab/__init__.py"))
              d2 = list(difflib.unified_diff([], test_code.splitlines(True),
                        "a/tests/test_conventional_commit.py", "b/tests/test_conventional_commit.py"))
              patch = "--- feat/conventional-commit\n" + "".join(d1) + "".join(d2)
              status = "ok"
          except Exception as e:
              status = "error: " + repr(e)[:300]
              raw_tail = (raw_tail + "\n[" + _LAST["cmd"] + "]\n" + _LAST["stderr"]).strip()[-4000:]

          payload = json.dumps({
              "task": "lab-conventional-commit", "status": status,
              "fetched_at": datetime.datetime.now(datetime.timezone.utc).isoformat(),
              "answer": answer[:20000], "patch": patch[:30000],
              "tests_out": tests_out[:2000], "raw_tail": raw_tail[:3000],
          }, ensure_ascii=False).encode()
          req = urllib.request.Request(RECEIVER, data=payload, headers={"Content-Type": "application/json"})
          try:
              code = urllib.request.urlopen(req, timeout=15).status
          except Exception as e:
              code = repr(e)
          print("PHASE_POST:", code, flush=True)
          print("FINAL_STATUS:", status, flush=True)
